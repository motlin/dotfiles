Host *
  AddKeysToAgent yes
  UseKeychain yes
  # mac.conf.yaml links this to the 1Password SSH agent socket.
  IdentityAgent "~/.1password/agent.sock"

Host github.com
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host github.com
  IdentityFile ~/.ssh/factorio_id_ed25519
  IdentitiesOnly yes

Host MotlinGitHub
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host FactorioBlueprintsGitHub
  HostName github.com
  User git
  IdentityFile ~/.ssh/factorio_id_ed25519
  IdentitiesOnly yes
