#!/usr/bin/env bash

set -euo pipefail

# Prevent npm 11 from reading the deprecated node-gyp option inherited from older shells.
unset npm_config_nodedir NPM_CONFIG_NODEDIR

DEFAULT_CONFIG_PREFIX="install"
CONFIG_SUFFIX=".conf.yaml"
DOTBOT_DIR="dotbot"
MISE_INSTALLER_LOCATION="https://mise.run"
MISE_DOWNLOAD_RESTRICTED_CONFIGURATION="2s"
VERBOSE_OPTION="--verbose"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

function configuration_requested() {
    local expected_configuration="$1"
    local requested_configuration

    shift
    for requested_configuration in "$@"; do
        if [[ "${requested_configuration}" == "${expected_configuration}" ]]; then
            return 0
        fi
    done

    return 1
}

export DOTFILES_INSTALL_VERBOSE=false

for conf in "${DEFAULT_CONFIG_PREFIX}" "${@}"; do
    if [[ "${conf}" == "${VERBOSE_OPTION}" ]]; then
        export DOTFILES_INSTALL_VERBOSE=true
        continue
    fi

    if [[ ! -f "${BASEDIR}/${conf}${CONFIG_SUFFIX}" ]]; then
        echo "No such profile: ${conf}${CONFIG_SUFFIX}" >&2
        exit 1
    fi
done

if configuration_requested "${MISE_DOWNLOAD_RESTRICTED_CONFIGURATION}" "$@"; then
    export DOTFILES_INSTALL_MISE_TOOLS=false
else
    export DOTFILES_INSTALL_MISE_TOOLS=true
    if ! command -v mise >/dev/null 2>&1; then
        if ! command -v curl >/dev/null 2>&1; then
            echo "curl is required to bootstrap mise." >&2
            exit 1
        fi

        curl --fail --location --show-error "${MISE_INSTALLER_LOCATION}" | sh
        export PATH="${HOME}/.local/bin:${PATH}"

        if ! command -v mise >/dev/null 2>&1; then
            echo "mise was installed but is not available on PATH." >&2
            exit 1
        fi
    fi
fi

cd "${BASEDIR}"
git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --quiet --init --recursive "${DOTBOT_DIR}"

for conf in "${DEFAULT_CONFIG_PREFIX}" "${@}"; do
    if [[ "${conf}" == "${VERBOSE_OPTION}" ]]; then
        continue
    fi

    if [[ "${DOTFILES_INSTALL_VERBOSE}" == true ]]; then
        "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -vv -d "${BASEDIR}" -c "${conf}${CONFIG_SUFFIX}"
    else
        "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${conf}${CONFIG_SUFFIX}"
    fi
done
