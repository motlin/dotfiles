alias x='exit'
alias v='vim'
alias vi='vim'
alias vd='vim -d'
alias grep='grep --color'

# 📁 ls aliases
alias l='eza --long --classify --header --color-scale --icons --no-permissions --time-style iso'
alias la='l --all'
alias lt='la --no-user --sort modified'

# 🔀 git aliases
alias s='git st'
alias ss='git status --short'
alias gl='git l'
alias ga='git la'
alias g='git la'
alias gaa='git laa'
alias gf='git f'
alias ri='git ri'
alias m='git m'
alias dif='git diff'
alias cached='git diff --cached'
alias skip='git rebase --skip'
alias cont='git rebase --continue'
alias fixup='git ci --fixup HEAD'
alias gtree='git ls-files | tree --fromfile'
alias f="git ls-files | fzf --preview 'bat --color=always --style=numbers {}' --preview-window=right:60%:wrap --bind 'ctrl-u:preview-page-up,ctrl-d:preview-page-down,ctrl-f:preview-page-down,ctrl-b:preview-page-up'"

alias up='cd ..'
alias up2='cd ../..'
alias up3='cd ../../..'
alias up4='cd ../../../..'

alias now='date +"%Y-%m-%d %H:%M:%S"'
alias log="TZ='EST+5' ts '%Y-%m-%d %H:%M:%.S'"

alias cat='bat'
alias lg='lazygit'
alias j='just --global-justfile'
alias simple-prompt="p10k display '1/*'=hide '1/left/prompt_char'=show"

alias c='claude --chrome'
alias cc='c --continue'
alias cr='c --resume'
alias rc='claude rc --permission-mode auto --spawn worktree'
# alias yolo='c --permission-mode acceptEdits'
alias yolo='codex'
# One generation behind codex's default model, for routine plugin commands.
alias lite='yolo --model gpt-5.6-sol'

# 🔧 Plugin command aliases; claude's /name form commented out, codex's $name form live.
# shellcheck disable=SC2154 # $git and friends are prompt names, not variables.
# alias commit='yolo /git:commit'
alias commit='lite "\$git:commit"'
# alias conflicts='yolo /git:conflicts'
alias conflicts='lite "\$git:conflicts"'
# alias rebase-all='yolo /git:rebase-all'
alias rebase-all='lite "\$git:rebase-all"'
# shellcheck disable=SC2154
# alias fix='yolo /build:fix'
alias fix='lite "\$build:fix"'
# shellcheck disable=SC2154
# alias add-task='yolo /markdown-tasks:add-one-task'
alias add-task='lite "\$markdown-tasks:add-one-task"'
# alias do-all-tasks='yolo /markdown-tasks:do-all-tasks'
alias do-all-tasks='yolo "\$markdown-tasks:do-all-tasks"'

alias rsync="rsync --archive --verbose --info=progress2 --human-readable --partial"
