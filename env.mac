export PATH=/opt/homebrew/bin:$PATH
export PATH="$(brew --prefix)/opt/python@3.11/libexec/bin:$PATH"
export PATH="/opt/homebrew/opt/findutils/libexec/gnubin:$PATH"

export XDG_DATA_DIRS=$XDG_DATA_DIRS:/opt/homebrew/share

export TERM=xterm-256color

# gcloud's launcher prefers the newest Homebrew python3.x on PATH over its own virtualenv,
# so point it at the virtualenv the gcloud-cli cask builds, and let Homebrew own its updates.
export CLOUDSDK_PYTHON="$HOME/.config/gcloud/virtenv/bin/python3"
export CLOUDSDK_PYTHON_SITEPACKAGES=1
export HOMEBREW_UPGRADE_GREEDY_CASKS="gcloud-cli"
