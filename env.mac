export PATH=/opt/homebrew/bin:$PATH
export PATH="/opt/homebrew/opt/findutils/libexec/gnubin:$PATH"

export TERM=xterm-256color

# gcloud's launcher prefers the newest Homebrew python3.x on PATH over its own virtualenv,
# so point it at the virtualenv the gcloud-cli cask builds.
export CLOUDSDK_PYTHON="$HOME/.config/gcloud/virtenv/bin/python3"
export CLOUDSDK_PYTHON_SITEPACKAGES=1
